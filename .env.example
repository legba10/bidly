# Safe, non-secret local defaults. Copy to .env and change locally as needed.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:3001

# Local PostgreSQL only. Use a secret manager for deployed credentials.
DATABASE_URL=postgresql://bidly:bidly_local_only@127.0.0.1:5432/bidly
TEST_DATABASE_URL=postgresql://bidly:bidly_local_only@127.0.0.1:5432/bidly_test
BIDLY_ALLOW_DEV_SEED=0
BIDLY_FEATURE_FLAGS=

# Never place real credentials, tokens, personal data, or production endpoints here.
