{
  "name": "bidly",
  "version": "0.0.0",
  "private": true,
  "description": "Production-grade engineering foundation for the Bidly reverse marketplace",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter ./apps/* run build",
    "build:packages": "pnpm --filter ./packages/* run build",
    "build:storybook": "pnpm build:packages && storybook build --disable-telemetry --config-dir packages/ui/.storybook --output-dir storybook-static",
    "api:generate": "pnpm --filter @bidly/validation generate:openapi",
    "dev": "pnpm build:packages && pnpm --filter ./apps/* --parallel run dev",
    "db:migrate": "pnpm --filter @bidly/database migrate",
    "db:seed:dev": "pnpm --filter @bidly/database seed:dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint . --max-warnings=0",
    "storybook": "pnpm build:packages && storybook dev --disable-telemetry --config-dir packages/ui/.storybook --port 6006",
    "test": "pnpm build:packages && vitest run --project unit --project component --project accessibility",
    "test:a11y": "pnpm build:packages && vitest run --project accessibility",
    "test:component": "pnpm build:packages && vitest run --project component",
    "test:coverage": "pnpm build:packages && vitest run --coverage --project unit --project component",
    "test:e2e": "pnpm build && playwright test",
    "test:integration": "pnpm build:packages && vitest run --project integration",
    "test:storybook": "pnpm build:packages && vitest run --project storybook",
    "typecheck": "tsc -p tsconfig.json && pnpm --recursive --if-present run typecheck",
    "security:deps": "node scripts/security/run-tool.mjs osv-scanner scan source --recursive .",
    "security:iac": "node scripts/security/run-tool.mjs trivy fs --scanners vuln,misconfig,secret --severity HIGH,CRITICAL --exit-code 1 --skip-dirs node_modules --skip-dirs .tools --skip-dirs apps/web/.next --skip-dirs storybook-static --skip-dirs coverage --skip-dirs playwright-report --skip-dirs test-results .",
    "security:sast": "node scripts/security/run-tool.mjs semgrep scan --config .semgrep.yml --error --metrics=off .",
    "security:secrets": "node scripts/security/run-tool.mjs gitleaks dir . --redact --no-banner --config .gitleaks.toml",
    "security:tools:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/security/bootstrap-windows.ps1",
    "security:all": "pnpm security:secrets && pnpm security:deps && pnpm security:sast && pnpm security:iac",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:storybook && pnpm build:storybook && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@bidly/testing": "workspace:*",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.5.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
